// Add to default/omarchy/omarchy-menu.jsonc in basecamp/omarchy.
// Matches the other Gaming rows: install rows use disabled: (dim once
// installed), remove rows use when: (hidden unless installed).

"install.gaming.quake": {
  "icon": "",
  "label": "Quake",
  "disabled": "omarchy-pkg-present omarchy-quake",
  "action": "omarchy-launch-floating-terminal-with-presentation omarchy-install-gaming-quake"
},
"remove.gaming.quake": {
  "icon": "",
  "label": "Quake",
  "when": "omarchy-pkg-present omarchy-quake",
  "action": "omarchy-launch-floating-terminal-with-presentation omarchy-remove-gaming-quake"
},
